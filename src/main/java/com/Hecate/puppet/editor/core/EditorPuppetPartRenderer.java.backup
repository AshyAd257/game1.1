     * 鐠佸墽鐤嗘稉顓炵妇閻愰€涚秴缂冾噯绱橵ector3f锟?
     */
    public void setPivotPoint(Vector3f pivot) {
        this.pivotPoint.set(pivot);
        updatePivotMarkerPosition();
    }

