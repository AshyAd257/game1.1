    /**
     * 鐠佸墽鐤嗚创鍥炬棆杞搴﹂敍鍫濆閺佸府绱濋弨顖涘瘮澶氬湀鏃嬭浆锟?
     */
    public void setTextureRotation(float degrees) {
        this.textureRotation = degrees;
        this.useAnimationRotation = true;  // 鏍囪顔囨稉杞板▏閻劌濮╅悽缁樻锟?
        updateTexCoords();
    }

    /**
     * 鐠佸墽鐤嗚创鍥炬棆杞搴﹂敍鍫濆敶闁劍鏌熷▔鏇礉娑撳秵鏁奸崣姒皊eAnimationRotation閺嶅洤绻旓紙
     * 鐢ㄤ簬鍔ㄧ敾绯荤粺閸︺劑娼幘顓熸杹閻樿埖鈧椒绗呮惔鏃傛暏閸忔娊鏁敮褍锟?
     */
    public void setTextureRotationInternal(float degrees) {
        this.textureRotation = degrees;
        // 娑撳秳鎱ㄩ弨绠剆eAnimationRotation閺嶅洤绻旈敍灞肩箽閹镐箒I閹貉冨煑锟?
        updateTexCoords();
    }

