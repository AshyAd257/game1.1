  public class ElementPainter {
      public void paintSurface(Vector3f position, ElementType element,
                             float intensity, float radius) {
          // 获取影响范围内的表面
          List<Surface> affectedSurfaces = getSurfacesInRadius(position, radius);

          for (Surface surface : affectedSurfaces) {
              // 计算距离衰减
              float distance = position.distance(surface.getPosition());
              float effectiveIntensity = intensity * (1.0f - distance / radius);

              // 应用元素效果
              ElementEffect effect = surface.applyElement(element, effectiveIntensity);

              // 触发粒子效果
              particleSystem.createElementEffect(surface.getPosition(), element, effect);

              // 播放音效
              audioSystem.playElementSound(element, effectiveIntensity);

              // 检查元素反应
              checkElementalReactions(surface, element);
          }
      }

      private void checkElementalReactions(Surface surface, ElementType newElement) {
          ElementType existingElement = surface.getDominantElement();
          if (existingElement != null && existingElement != newElement) {
              ElementReaction reaction = ElementReaction.getReaction(existingElement, newElement);
              if (reaction != null) {
                  reaction.trigger(surface);
              }
          }
      }
  }
