  public class WeaponDamageCalculator {
      public DamageResult calculateDamage(WeaponBase weapon, Entity target,
                                         Vector3f hitPoint, float distance) {
          // 基础伤害
          float baseDamage = weapon.getBaseDamage();

          // 距离衰减
          float distanceFactor = calculateDistanceFactor(weapon, distance);

          // 部位修正
          float bodyPartModifier = calculateBodyPartModifier(target, hitPoint);

          // 元素效果
          float elementalModifier = calculateElementalModifier(weapon, target);

          // 护甲减免
          float armorReduction = calculateArmorReduction(target, weapon.getDamageType());

          // 计算最终伤害
          float finalDamage = baseDamage * distanceFactor * bodyPartModifier *
                             elementalModifier * (1.0f - armorReduction);

          // 暴击判定
          boolean isCritical = checkCriticalHit(weapon, target, hitPoint);
          if (isCritical) {
              finalDamage *= weapon.getCriticalMultiplier();
          }

          return new DamageResult(finalDamage, isCritical, weapon.getDamageType());
      }

      private float calculateDistanceFactor(WeaponBase weapon, float distance) {
          float optimalRange = weapon.getOptimalRange();
          float maxRange = weapon.getMaxRange();

          if (distance <= optimalRange) {
              return 1.0f;
          } else if (distance <= maxRange) {
              return 1.0f - (distance - optimalRange) / (maxRange - optimalRange) * 0.5f;
          } else {
              return 0.1f; // 最小伤害
          }
      }
  }
